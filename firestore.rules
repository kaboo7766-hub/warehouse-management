rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function mail() {
      return request.auth.token.email.lower();
    }
    function superAdmin() {
      return signedIn() && mail() == 'kaboo7766@gmail.com';
    }
    function allowedPath() {
      return /databases/$(database)/documents/allowed/$(mail());
    }
    function isUser() {
      return superAdmin() || (signedIn() && exists(allowedPath()) && get(allowedPath()).data.active == true);
    }
    function isAdmin() {
      return superAdmin() || (isUser() && get(allowedPath()).data.role == 'admin');
    }
    function qtyOk() {
      return request.resource.data.q is number && request.resource.data.q > 0;
    }
    function outOk() {
      return request.resource.data.q is number && request.resource.data.q >= 0
        && request.resource.data.get('xq', 0) is number && request.resource.data.get('xq', 0) >= 0
        && (request.resource.data.q > 0 || request.resource.data.get('xq', 0) > 0);
    }
    function onlyVoid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedBy', 'voidedMs']);
    }

    // لا يُسمح بالحذف نهائيًا في أي مجموعة: الإلغاء والإخفاء تعديل فقط، والسجل محفوظ دائمًا.

    match /allowed/{p} {
      allow get: if signedIn() && p == mail();
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
    match /meta/{id} {
      allow read: if isUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /warehouses/{id} {
      allow read: if isUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if isUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /contractors/{id} {
      allow read: if isUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /vessels/{id} {
      allow read: if isUser();
      allow create: if isUser() && qtyOk();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /stored/{id} {
      allow read: if isUser();
      allow create: if isUser() && qtyOk();
      allow update: if isAdmin() && onlyVoid();
      allow delete: if false;
    }
    match /outgoing/{id} {
      allow read: if isUser();
      allow create: if isUser() && outOk();
      allow update: if isAdmin() && onlyVoid();
      allow delete: if false;
    }
    match /logins/{id} {
      allow read: if isAdmin() || (isUser() && resource.data.uid == request.auth.uid);
      allow create: if isUser() && request.resource.data.uid == request.auth.uid;
      allow update: if isUser() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
